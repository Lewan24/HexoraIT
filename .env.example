HEXORAIT_DB_PASSWORD=replace-with-a-strong-database-password
HEXORAIT_JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
HEXORAIT_PUBLIC_ORIGIN=https://it.example.com
# NPM source IP as seen in frontend access logs (may differ due to Docker NAT).
HEXORAIT_NPM_IP=192.168.1.10
# Docker host address reachable from NPM; use 127.0.0.1 for a host-native proxy.
HEXORAIT_FRONTEND_BIND_IP=192.168.1.20
HEXORAIT_FRONTEND_PORT=8080
# Change all three together only if this subnet overlaps an existing network.
HEXORAIT_BACKEND_SUBNET=172.30.50.0/29
HEXORAIT_API_IP=172.30.50.2
HEXORAIT_FRONTEND_IP=172.30.50.3
